  "routes": [
    {
      "surface": "before_tool_call / tool-result middleware / prompt hooks",
      "disposition": "covered_by_prior_inventory",
      "basis": "Prior pinned hook/SDK search and actual removed-entry capture; callbacks expose no live library-entry capability. Retained borrow fixes authority currentness but does not add library state."
    },
    {
      "surface": "retain() + provider onPayload + public gateway dispatch",
      "disposition": "attempted_refused",
      "basis": "New VPS capture: borrow found and current after RPC; skills.library.list throws authenticated_request_scope_unavailable; zero model HTTP requests."
    },
    {
      "surface": "public runtime agent session readers",
      "disposition": "not_a_library_currentness_api",
      "basis": "Session entries/pins do not establish nonremoved current Skill Library entries; prior deletion capture retains pinned bytes."
    },
    {
      "surface": "skill-commands-runtime / agent-workspace-runtime",
      "disposition": "not_a_library_currentness_api",
      "basis": "Exports workspace command lists/resource file readers; not personal Skill Library live entry/tombstone authority."
    },
    {
      "surface": "SkillLibraryAuthoringCapability on custom harness attempt",
      "disposition": "replacement_executor_out_of_scope",
      "basis": "Capability exists. Public harness registration requires implementing runAttempt; no same-attempt builtin wrapper/delegation export found. New executor excluded by spec1; native baseline preserved by RM39/7.6.1."
    },
    {
      "surface": "runtime.agent.runEmbeddedAgent",
      "disposition": "new_run_not_same_attempt_delegation",
      "basis": "Public RuntimeRunEmbeddedAgentParams excludes admittedRunContext and preparedRunAdmission; it admits another run, not a wrapper around the current builtin attempt."
    },
    {
      "surface": "internal runtime imports / private library store reads / synthesized request scope",
      "disposition": "unsupported_boundary",
      "basis": "Not a supported public library access or delegation contract; structural identities and previous state cannot supply current authority under7.6.1."
    }
  ],
