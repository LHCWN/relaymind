{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaymind.local/schemas/guidance_request.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_text", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "task_text": {"type": "string", "minLength": 1},
    "recent_text": {"type": "string"},
    "max_picks": {"type": "integer", "minimum": 1, "maximum": 20},
    "assets": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["skill", "mcp_tool"]},
          "description": {"type": "string"},
          "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}
        },
        "dependentRequired": {
          "content_hash": ["path", "size_bytes"],
          "path": ["content_hash", "size_bytes"],
          "size_bytes": ["content_hash", "path"]
        },
        "if": {"properties": {"kind": {"const": "mcp_tool"}}},
        "then": {"not": {"anyOf": [{"required": ["content_hash"]}, {"required": ["path"]}, {"required": ["size_bytes"]}]}}
      }
    }
  }
}
