{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaymind.local/schemas/guidance_result.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "picks", "chosen_by", "mechanism", "degraded", "offered", "shortlist", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "decision": {"enum": ["picks", "choose", "no_match"]},
    "picks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["skill", "mcp_tool"]},
          "summary": {"type": "string"}
        }
      }
    },
    "chosen_by": {"enum": ["word_match", "external_model", "third_party", "none"]},
    "mechanism": {"type": "string", "minLength": 1},
    "degraded": {"type": "boolean"},
    "offered": {"type": "integer", "minimum": 0},
    "shortlist": {"type": "integer", "minimum": 0},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "outcome", "ms", "usage"],
        "properties": {
          "stage": {"enum": ["word_match", "keywords", "picker", "third_party"]},
          "outcome": {"enum": ["ok", "skipped", "failed", "timeout"]},
          "ms": {"type": "number", "minimum": 0},
          "usage": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_tokens", "output_tokens"],
                "properties": {
                  "input_tokens": {"type": ["integer", "null"], "minimum": 0},
                  "output_tokens": {"type": ["integer", "null"], "minimum": 0}
                }
              }
            ]
          }
        }
      }
    }
  }
}
